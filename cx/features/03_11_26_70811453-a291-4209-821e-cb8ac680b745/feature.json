    "content" : [ {
      "type" : "text",
      "text" : "Booking rules (the part the descriptors cannot carry)"
    } ]
  }, {
    "id" : "457a3132",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "These are enforced in a save-time validator on Booking, which reads the referenced Room and other Bookings."
    } ]
  }, {
    "id" : "f419b559",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "Time window (R1, A5)",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : ": end is strictly after start, both fall on the same calendar day, start is at or after 08:00, and end is at or before 20:00. A Booking may end exactly at 20:00. The check applies on every save, whatever the status."
    } ]
  }, {
    "id" : "da1a3e83",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "Capacity (R2, A6)",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : ": "
    }, {
      "type" : "text",
      "text" : "attendees",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " is at most the referenced Room's "
    }, {
      "type" : "text",
      "text" : "capacity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ". 12 of 12 is accepted and 13 is refused."
    } ]
  }, {
    "id" : "feeb6157",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "Status transitions (R4, A7)",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : ": a new Booking is created as requested. confirmed is reachable only from requested, so cancelled to confirmed is refused. cancelled is reachable from requested or confirmed. Whether confirmed to requested is allowed is not stated in the spec, so the lifecycle transition table in the descriptor is followed as shipped."
    } ]
  }, {
    "id" : "5eb427d5",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "No overlap among confirmed Bookings (P1, R3, A1–A4, A8)",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : ":"
    } ],
    "children" : [ {
      "id" : "68796f0d",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "The check runs when a Booking becomes confirmed, and when a Booking that is already confirmed is saved with a changed room, start or end."
      } ]
    }, {
      "id" : "ceaec719",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "It looks only at other confirmed Bookings of the same Room, excluding the Booking itself."
      } ]
    }, {
      "id" : "8ce9dc34",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "Two windows overlap when "
      }, {
        "type" : "text",
        "text" : "a.start < b.end",
        "styles" : {
          "code" : true
        }
      }, {
        "type" : "text",
        "text" : " and "
      }, {
        "type" : "text",
        "text" : "b.start < a.end",
        "styles" : {
          "code" : true
        }
      }, {
        "type" : "text",
        "text" : ". Touching windows therefore do not overlap (A2)."
      } ]
    }, {
      "id" : "b83836f4",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "Requested and cancelled Bookings are never counted. Cancelling therefore frees the slot (R5, A4), and a requested Booking can be saved beside a confirmed one (A3)."
      } ]
    }, {
      "id" : "8801e0e7",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "A refusal rejects the save and leaves the stored row unchanged (A8)."
      } ]
    }, {
      "id" : "7c5c7fe5",
      "type" : "bulletListItem",
      "content" : [ {
        "type" : "text",
        "text" : "Concurrent confirmations of the same Room must not both succeed. The check and the write run in the same transaction, serialised per Room."
      } ]
    } ]
  }, {
    "id" : "7be1dfb0",
    "type" : "heading",
