      "type" : "text",
      "text" : "Room",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " and "
    }, {
      "type" : "text",
      "text" : "Booking",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " in package "
    }, {
      "type" : "text",
      "text" : "office.booking",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ". Nothing is reused or migrated (Migration: none)."
    } ]
