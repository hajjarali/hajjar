      "type" : "text",
      "text" : "country",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (text, optional), "
    }, {
      "type" : "text",
      "text" : "active",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (flag, required, defaults to true). The entity descriptor "
    }, {
      "type" : "text",
      "text" : "entity_descriptors/procurement.Supplier.json",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " and the default form "
    }, {
      "type" : "text",
      "text" : "ui/procurement.Supplier.js",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " are authored at spec time and shipped verbatim into the module. The entity gets its observer sheet as its only remote surface. There are no references to or from other records."
    } ]
