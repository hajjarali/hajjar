      "type" : "text",
      "text" : "name",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (text, required), "
    }, {
      "type" : "text",
      "text" : "contactEmail",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (text, optional, email-format validation), "
