      "type" : "text",
      "text" : "simpledao.Demo*",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " family, the "
    }, {
      "type" : "text",
      "text" : "system.*",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " platform tables, IAM and integration connections. None is a person/contact register and none carries a reusable person shape, so "
    }, {
      "type" : "text",
      "text" : "people.Person",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " is genuinely new; "
    }, {
      "type" : "text",
      "text" : "platformSpecs",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " shows only the "
    }, {
      "type" : "text",
      "text" : "test",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " spec itself covering this ground. The entity is modelled exactly as the spec's descriptor ("
