      }
    }, {
      "type" : "text",
      "text" : " and no external media reference, and it draws on a canvas."
    } ]
  }, {
    "id" : "03d45eab",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "(A2) Holding Right for 1 s raises the cat's x and stops it at the right edge, and Left does the same at the left edge. A tap on the left half moves the cat left."
    } ]
  }, {
    "id" : "56a17666",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "(A10) Resizing from 1280x720 to 400x800 leaves the whole field visible at its aspect ratio."
    } ]
  }, {
    "id" : "b247cd6b",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
