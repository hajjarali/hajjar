      "level" : 3
    },
    "content" : [ {
      "type" : "text",
      "text" : "Task 2: Falling objects, difficulty, collisions, lives, score and game over"
    } ]
  }, {
    "id" : "59aa85ae",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "Depends on",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : ": Task-1 (the phase machine, loop, cat and "
    }, {
      "type" : "text",
      "text" : "window.__game",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " handle in cucumber-panic.html)"
    } ]
  }, {
