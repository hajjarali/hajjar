      "text" : ":"
    } ]
  }, {
    "id" : "640b9e4d",
    "type" : "bulletListItem",
    "content" : [ {
      "type" : "text",
      "text" : "(A1) The file contains no "
    }, {
      "type" : "text",
      "text" : "src=",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " or "
    }, {
