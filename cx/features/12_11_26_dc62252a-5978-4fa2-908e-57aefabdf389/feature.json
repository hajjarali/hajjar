      "text" : "Entity: CustomerNote"
    } ]
  }, {
    "id" : "8ba17ad9",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "CustomerNote is a new root bean (package "
    }, {
      "type" : "text",
      "text" : "customer",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : "); the spec's Dependencies section names no existing entity to reuse. Fields: "
    }, {
      "type" : "text",
      "text" : "customerName",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (text, required), "
    }, {
      "type" : "text",
      "text" : "noteText",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (longtext, required), "
    }, {
      "type" : "text",
      "text" : "createdDate",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (date, optional). Both required fields are enforced by the entity's validation, so a save without either is refused (R1). No key or uniqueness is specified; none is added."
    } ]
  }, {
    "id" : "bbbd54fc",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "The entity descriptor "
    }, {
      "type" : "text",
      "text" : "entity_descriptors/customer.CustomerNote.json",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " and the default form "
