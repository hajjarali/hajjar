      "type" : "text",
      "text" : "ui/customer.CustomerNote.js",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " are spec attachments. Both are shipped verbatim into the module, not redesigned."
    } ]
  }, {
