    } ]
  }, {
    "id" : "99c0b108",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "Adds a CustomerNote entity with required customer name and note text, shipping the approved descriptor and default form verbatim. Exposes it through an observer sheet that lists notes newest first by createdDate. Builds the Customer notes screen from the spec's mock, a standard table beside a side-panel form, and registers it under Customers › Customer notes. Three tasks."
    } ]
  }, {
    "id" : "feature-design-h",
    "type" : "heading",
    "props" : {
      "level" : 2
    },
    "content" : [ {
      "type" : "text",
      "text" : "Design"
