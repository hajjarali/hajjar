      "text" : "Design"
    } ]
  }, {
    "id" : "101c8bd5",
    "type" : "heading",
    "props" : {
      "level" : 3
    },
    "content" : [ {
      "type" : "text",
      "text" : "Entity: "
    }, {
      "type" : "text",
      "text" : "cdm.party.LegalEntity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " — new"
    } ]
  }, {
    "id" : "4ba6f135",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "One new persistable entity, "
    }, {
      "type" : "text",
      "text" : "cdm.party.LegalEntity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (class "
    }, {
      "type" : "text",
      "text" : "cyai.cdm.party.LegalEntity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", table "
    }, {
      "type" : "text",
      "text" : "legal_entity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : "), exactly as the spec's descriptor attachment fixes it. The reuse gate confirms it is genuinely new: "
    }, {
      "type" : "text",
      "text" : "platformEntities",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " lists 70 served entities, none a legal-entity register, and the workspace source is a bare skeleton ("
    }, {
      "type" : "text",
      "text" : "com.example.App",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " only) — nothing to extend, no domain plane to fit into. It realises the CDM type "
    }, {
      "type" : "text",
      "text" : "cdm.base.staticdata.party.LegalEntity",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (cdm corpus: a required "
    }, {
      "type" : "text",
      "text" : "name",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " and a "
    }, {
      "type" : "text",
      "text" : "List<EntityIdentifier>",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ") as vocabulary: the CDM type carries "
    }, {
      "type" : "text",
      "text" : "entityIdentifier",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " as a list of "
    }, {
      "type" : "text",
      "text" : "EntityIdentifier",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " beans ("
    }, {
      "type" : "text",
      "text" : "identifier",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " + "
    }, {
      "type" : "text",
      "text" : "EntityIdentifierTypeEnum",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : "), and this register narrows that to the one identifier FCY's standing rule R7 keys on — the LEI — held flat, per the spec's own rationale. A second identifier scheme would widen the field back to an embedded list without changing consumers; nothing in this design pre-builds that."
    } ]
  }, {
    "id" : "8bac08e0",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "The descriptor is "
    }, {
      "type" : "text",
      "text" : "shipped verbatim",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : " from the spec attachment "
    }, {
      "type" : "text",
      "text" : "entity_descriptors/cdm.party.LegalEntity.json",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " to the entity's descriptor home — it is spec-time authored, not redesigned here. Its shape, for reference: "
    }, {
      "type" : "text",
      "text" : "PERSISTABLE_BEAN",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", version 1, "
    }, {
      "type" : "text",
      "text" : "AUTO_INCREMENT",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " ids, "
    }, {
      "type" : "text",
      "text" : "starSchemaRole: DIM",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (master data other entities point at), cache "
    }, {
      "type" : "text",
      "text" : "NONE",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", one index group "
    }, {
      "type" : "text",
      "text" : "by_status",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", no natural-key group, no relationships."
    } ]
  }, {
    "id" : "e6e6258c",
    "type" : "heading",
    "props" : {
      "level" : 3
    },
    "content" : [ {
      "type" : "text",
