          "type" : "text",
          "text" : "persistence"
        } ], [ {
          "type" : "text",
          "text" : "validation"
        } ], [ {
          "type" : "text",
          "text" : "view"
        } ] ]
      }, {
        "cells" : [ [ {
          "type" : "text",
          "text" : "`name`"
        } ], [ {
