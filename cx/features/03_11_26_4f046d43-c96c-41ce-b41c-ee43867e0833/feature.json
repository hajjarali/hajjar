      "type" : "text",
      "text" : "auto-fit",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " columns, a single-column layout at 360 px, and "
    }, {
      "type" : "text",
      "text" : "overflow-x",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " guarded by "
    }, {
      "type" : "text",
      "text" : "min-width: 0",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " and wrapped text so nothing overlaps at 360, 768 and 1280 px. Smooth scrolling and IntersectionObserver scroll-reveal sit behind "
    }, {
      "type" : "text",
      "text" : "prefers-reduced-motion: no-preference",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", so reduced-motion visitors get no reveal or hero animation. Every link, button and the toggle gets a visible "
