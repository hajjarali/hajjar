      "text" : "ui/cdm.base.staticdata.party.LegalEntity.js",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " is shipped verbatim beside the entity class. The \"Legal entities\" screen follows the mock "
