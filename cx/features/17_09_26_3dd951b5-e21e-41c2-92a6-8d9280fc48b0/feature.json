      "type" : "text",
      "text" : "/about",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (A2). The link is part of the standard navigation markup shared by the site's pages, so it renders on the landing page load without any per-visitor state."
    } ]
  }, {
    "id" : "1a44d1b5",
    "type" : "heading",
