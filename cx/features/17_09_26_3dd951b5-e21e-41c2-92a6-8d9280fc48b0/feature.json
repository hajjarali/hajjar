    "content" : [ {
      "type" : "text",
      "text" : "Design"
    } ]
  }, {
    "id" : "58231810",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "A single static "
    }, {
      "type" : "text",
      "text" : "About",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : " page on the public landing site: one heading and a few body paragraphs served at "
    }, {
      "type" : "text",
      "text" : "/about",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " to every visitor, plus a navigation link to it from the landing page. No editing, no personalisation, no localisation."
    } ]
  }, {
    "id" : "360afd7a",
    "type" : "paragraph",
    "content" : [ {
      "type" : "text",
      "text" : "Reuse check (live catalogs):",
      "styles" : {
        "bold" : true
      }
    }, {
      "type" : "text",
      "text" : " "
    }, {
      "type" : "text",
      "text" : "platformEntities",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " lists 60 served entities — all demo ("
    }, {
      "type" : "text",
      "text" : "simpledao.*",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : "), platform-internal ("
    }, {
      "type" : "text",
      "text" : "system.*",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ") or knowledge/registry entities; none models public page content, and the spec's Data model section explicitly says none is created. The repository is a bare Maven jar ("
    }, {
      "type" : "text",
      "text" : "com.example:projecytt",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : ", Java 23, no dependencies) whose only source is "
    }, {
      "type" : "text",
      "text" : "src/main/java/com/example/App.java",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " (a Hello-World main). There is no web layer, no landing page and no view to extend yet, so this feature introduces the site's first static page and its first navigation markup. "
    }, {
      "type" : "text",
      "text" : "platformSpecs",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " shows only "
    }, {
      "type" : "text",
      "text" : "spec1 v2",
      "styles" : {
        "code" : true
      }
    }, {
      "type" : "text",
      "text" : " registered — this feature's own spec — so no other spec's ground is overlapped."
    } ]
  }, {
    "id" : "5f580bc1",
    "type" : "heading",
    "props" : {
      "level" : 3
    },
    "content" : [ {
      "type" : "text",
      "text" : "Data model"
    } ]
