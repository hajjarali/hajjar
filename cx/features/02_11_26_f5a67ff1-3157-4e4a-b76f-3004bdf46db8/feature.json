    "content" : [ {
      "type" : "text",
      "text" : "Extends the existing App class with a greeting method that returns the constant \"Hello, world\", and makes main use it. Adds a JUnit dependency to pom.xml and one test that checks the exact text. Nothing is stored and there is no screen, so the plan is one task."
    } ]
