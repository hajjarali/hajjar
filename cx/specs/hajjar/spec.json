{"spec_id":"7fc89062-f537-46f3-8b26-f62186fabae0","name":"hajjar","content":{"content":[{"id":"8f387c78-9002-4451-91ea-d39f1e25d983","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"5acd8b22","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Intent"}]},{"id":"b6e10e54","type":"paragraph","content":[{"type":"text","text":"Create a high-converting landing page for the Hajjar platform to introduce users to its core value proposition and drive sign-ups."}]},{"id":"fc301084","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Requirements"}]},{"id":"c23016ae","type":"heading","props":{"level":3},"content":[{"type":"text","text":"1. Hero Section"}]},{"id":"2958eea7","type":"bulletListItem","content":[{"type":"text","text":"Headline:","styles":{"bold":true}},{"type":"text","text":" Clear value proposition (e.g., \"The Future of Professional Networking\")."}]},{"id":"79b78e45","type":"bulletListItem","content":[{"type":"text","text":"Sub-headline:","styles":{"bold":true}},{"type":"text","text":" Supporting text explaining the benefit."}]},{"id":"4c789c44","type":"bulletListItem","content":[{"type":"text","text":"Call to Action (CTA):","styles":{"bold":true}},{"type":"text","text":" Primary button leading to the registration/onboarding flow."}]},{"id":"cca08d2a","type":"bulletListItem","content":[{"type":"text","text":"Visual:","styles":{"bold":true}},{"type":"text","text":" High-quality image or illustration representing the product."}]},{"id":"53f364eb","type":"heading","props":{"level":3},"content":[{"type":"text","text":"2. Features/Benefits Section"}]},{"id":"32dff27b","type":"bulletListItem","content":[{"type":"text","text":"Grid or list of at least 3 key features."}]},{"id":"1bb947a4","type":"bulletListItem","content":[{"type":"text","text":"Each feature must have an icon, a title, and a brief description."}]},{"id":"d96d14b5","type":"heading","props":{"level":3},"content":[{"type":"text","text":"3. Social Proof / Testimonials"}]},{"id":"4e276220","type":"bulletListItem","content":[{"type":"text","text":"A section displaying logos of partner companies or user testimonials to build trust."}]},{"id":"a3d6f746","type":"heading","props":{"level":3},"content":[{"type":"text","text":"4. Footer"}]},{"id":"43d506f3","type":"bulletListItem","content":[{"type":"text","text":"Links to Privacy Policy, Terms of Service, and Contact information."}]},{"id":"d1e51108","type":"bulletListItem","content":[{"type":"text","text":"Social media icons."}]},{"id":"06411be8","type":"heading","props":{"level":3},"content":[{"type":"text","text":"5. Technical Requirements"}]},{"id":"1e7b68fd","type":"bulletListItem","content":[{"type":"text","text":"Responsive Design:","styles":{"bold":true}},{"type":"text","text":" Must work on mobile, tablet, and desktop."}]},{"id":"227045c5","type":"bulletListItem","content":[{"type":"text","text":"Performance:","styles":{"bold":true}},{"type":"text","text":" Page should load in under 2 seconds."}]},{"id":"3c70c1f9","type":"bulletListItem","content":[{"type":"text","text":"SEO:","styles":{"bold":true}},{"type":"text","text":" Optimized meta titles and descriptions."}]},{"id":"3d3feb08","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scope"}]},{"id":"f8c406e7","type":"heading","props":{"level":3},"content":[{"type":"text","text":"In-Scope"}]},{"id":"f0f48cd1","type":"bulletListItem","content":[{"type":"text","text":"Design and implementation of the landing page UI."}]},{"id":"380eaba0","type":"bulletListItem","content":[{"type":"text","text":"Integration with the sign-up flow."}]},{"id":"3d7e5748","type":"bulletListItem","content":[{"type":"text","text":"Analytics for how long people stay in the page."}]},{"id":"e1f04223","type":"heading","props":{"level":3},"content":[{"type":"text","text":"Out-of-Scope"}]},{"id":"2c543f63","type":"bulletListItem","content":[{"type":"text