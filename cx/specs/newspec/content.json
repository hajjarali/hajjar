{"content":[{"id":"tpl-intent-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Intent","styles":{}}],"children":[]},{"id":"tpl-intent-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Describe what this spec is for.","styles":{}}],"children":[]},{"id":"tpl-scope-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scopeasdsadsadsad","styles":{}}],"children":[]},{"id":"tpl-scope-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"What is IN, and what is explicitly OUT (non-goals).","styles":{"italic":true}}],"children":[]},{"id":"tpl-scenarios-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scenarios","styles":{}}],"children":[]},{"id":"tpl-scenarios-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The journeys this must support, S1..Sn — each a sequence of steps with its branches and error paths. A scenario may be a person's journey or an automated process; it needs no screen.","styles":{"italic":true}}],"children":[]},{"id":"tpl-requirements-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Requirements","styles":{}}],"children":[]},{"id":"tpl-requirements-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Numbered R1..Rn — WHAT, one requirement each, never HOW. An always-true invariant is numbered P1..Pn.","styles":{"italic":true}}],"children":[]},{"id":"tpl-datamodel-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Data model","styles":{}}],"children":[]},{"id":"tpl-datamodel-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The business nouns this needs. Each NEW noun is a '### bean: Name' sub-heading followed by one table | field | kind | required | notes | (kinds are logical: text, number, money, date, flag, choice(...), ref(Noun), lifecycle(...)), then its relationships and uniqueness or lifecycle rules in prose. No Java types, no columns, no widgets.","styles":{"italic":true}}],"children":[]},{"id":"tpl-ui-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"User interface","styles":{}}],"children":[]},{"id":"tpl-ui-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The screens this needs and how they should feel: purpose, key interactions, and any layout or look you have an opinion about — prose, a sketch, or an HTML mock.","styles":{"italic":true}}],"children":[]},{"id":"tpl-dependencies-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Dependencies","styles":{}}],"children":[]},{"id":"tpl-dependencies-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"What this relies on: other specs, existing entities, external systems or services.","styles":{"italic":true}}],"children":[]},{"id":"tpl-constraints-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Constraints","styles":{}}],"children":[]},{"id":"tpl-constraints-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Rules the implementation must obey: security, performance targets, expected volume, cost, latency, locale, compliance. \"None.\" is a valid, explicit answer.","styles":{"italic":true}}],"children":[]},{"id":"tpl-acceptance-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Acceptance criteria","styles":{}}],"children":[]},{"id":"tpl-acceptance-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Numbered A1..An — each TESTABLE (pass/fail decidable), each naming the requirement(s) it verifies. Prefer \"WHEN [trigger], the system SHALL [response]\".","styles":{"italic":true}}],"children":[]},{"id":"tpl-migration-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Migration & compatibility","styles":{}}],"children":[]},{"id":"tpl-migration-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"What happens to what already exists — rows, users, callers: backfilled, defaulted, or grandfathered?","styles":{"italic":true}}],"children":[]},{"id":"tpl-artifacts-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Artifacts","styles":{}}],"children":[]},{"id":"tpl-artifacts-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"What will exist when done: entities, screens, services, migrations, docs.","styles":{"italic":true}}],"children":[]},{"id":"tpl-openq-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Open Questions","styles":{}}],"children":[]},{"id":"tpl-openq-p","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The clarification ledger: every assumption becomes a question here, and is REPLACED by the decision once one is made — never silently filled in.","styles":{"italic":true}}],"children":[]},{"id":"72a6fee4-5a2e-47dc-9b0c-8319306f4fdd","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}],"comments":[]}