{"content":[{"id":"tpl-intent-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Intent","styles":{"bold":true}}],"children":[]},{"id":"db081d4c-c4e7-403e-9433-b9063233fd95","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A trivial placeholder spec: the system greets a user by name. It exists to exercise the spec workflow, not to deliver business value.","styles":{}}],"children":[]},{"id":"tpl-scope-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scope","styles":{"bold":true}}],"children":[]},{"id":"93b0bb4f-7c94-4720-9547-b672f8b57103","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"IN: returning the greeting \"Hello, NAME!\" for a given name, where NAME is the supplied name.","styles":{}}],"children":[]},{"id":"2952d522-ca39-47fd-bb62-43df2f2b4fb3","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"OUT: storage, screens, localisation.","styles":{}}],"children":[]},{"id":"tpl-scenarios-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scenarios","styles":{"bold":true}}],"children":[]},{"id":"57d44898-8687-4500-90cd-118d2f7cca59","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — a single request/response, no ordering of steps matters.","styles":{}}],"children":[]},{"id":"tpl-requirements-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Requirements","styles":{"bold":true}}],"children":[]},{"id":"b5d6acaa-400c-4743-be79-ce35ae4f8bef","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R1: WHEN a name is supplied, the system SHALL return the text \"Hello, NAME!\", where NAME is the supplied name.","styles":{}}],"children":[]},{"id":"3ee8facc-bc72-4b19-96a0-da4dc1c1c873","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R2: ","styles":{}},{"type":"text","text":"IF no name is supplied, THEN the system SHALL return \"Hello, world!\".","styles":{"backgroundColor":"rgba(165, 160, 251, 0.3)"}}],"children":[]},{"id":"tpl-datamodel-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Data model","styles":{"bold":true}}],"children":[]},{"id":"ef937004-043f-46c5-80af-ec85d1dc3452","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — nothing is stored.","styles":{}}],"children":[]},{"id":"tpl-ui-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"User interface","styles":{"bold":true}}],"children":[]},{"id":"75934533-26ba-4f75-96eb-9beb42d04f00","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — no user-facing surface; the beans are edited through their default forms inside the screens that reach them.","styles":{"backgroundColor":"rgba(165, 160, 251, 0.3)"}}],"children":[]},{"id":"tpl-dependencies-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Dependencies","styles":{"bold":true}}],"children":[]},{"id":"ba691429-aa7b-425a-be37-c0c1379a25b7","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None.","styles":{}}],"children":[]},{"id":"tpl-constraints-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Constraints","styles":{"bold":true}}],"children":[]},{"id":"4a0cd209-7edf-4308-a282-6713890cc487","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Considered, none apply: authorization, performance, volume, availability, audit, privacy, locale, cost.","styles":{}}],"children":[]},{"id":"tpl-acceptance-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Acceptance criteria","styles":{"bold":true}}],"children":[]},{"id":"8893f969-63ea-4ce2-b4f6-05f39b8ed463","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A1 (verifies R1): WHEN the name \"Ada\" is supplied, the system SHALL return exactly \"Hello, Ada!\".","styles":{}}],"children":[]},{"id":"35e3660c-2617-4cc9-a79b-3bf2a2612557","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A2 (verifies R2): WHEN no name is supplied, the system SHALL return exactly \"Hello, world!\".","styles":{}}],"children":[]},{"id":"tpl-migration-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Migration & compatibility","styles":{"bold":true}}],"children":[]},{"id":"8e7c40c8-4805-4082-bc3b-08e135632368","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — new capability, nothing to migrate.","styles":{}}],"children":[]},{"id":"tpl-artifacts-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Artifacts","styles":{"bold":true}}],"children":[]},{"id":"aafd7027-f29f-4a0e-a472-f46ece5ea1f9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None.","styles":{}}],"children":[]},{"id":"tpl-openq-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Open Questions","styles":{"bold":true}}],"children":[]},{"id":"d1ffe0ca-fdf4-40cd-9c16-78e6d004b7c3","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None.","styles":{}}],"children":[]},{"id":"c6650f95-8afc-4df9-a0a8-1c25141d17cf","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}],"comments":[]}