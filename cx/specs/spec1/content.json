{"content":[{"id":"tpl-intent-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Intent"}]},{"id":"ae3bd455","type":"paragraph","content":[{"type":"text","text":"A single static \"About\" page on the public landing page: a short description of who the company is and what it does, reachable from the site's main navigation. No editing, no personalisation — just fixed content served to every visitor."}]},{"id":"tpl-scope-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scope"}]},{"id":"84f11fca","type":"bulletListItem","content":[{"type":"text","text":"IN: the "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":" route, its heading and body content, and a navigation link to it from the landing page."}]},{"id":"83876184","type":"bulletListItem","content":[{"type":"text","text":"OUT (non-goals): any content management or editing UI, localisation, contact forms, and any other landing-page section."}]},{"id":"tpl-scenarios-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scenarios"}]},{"id":"864662d7","type":"paragraph","content":[{"type":"text","text":"None — a static page with no process beyond opening it."}]},{"id":"tpl-requirements-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Requirements"}]},{"id":"bca39c4a","type":"bulletListItem","content":[{"type":"text","text":"R1: WHEN a visitor opens "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":", the system SHALL render the About page with its heading and body content."}]},{"id":"df6fdf7f","type":"bulletListItem","content":[{"type":"text","text":"R2: WHEN the landing page is loaded, the system SHALL include a navigation link to "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":"."}]},{"id":"tpl-datamodel-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Data model"}]},{"id":"bb127c65","type":"paragraph","content":[{"type":"text","text":"None — the page content is static; no entities are created or stored."}]},{"id":"tpl-ui-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"User interface"}]},{"id":"4b54ddaa","type":"paragraph","content":[{"type":"text","text":"A simple prose page: one page heading followed by a few paragraphs, styled consistently with the rest of the landing page. No interactive elements beyond the site's standard navigation."}]},{"id":"tpl-dependencies-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Dependencies"}]},{"id":"323373fc","type":"paragraph","content":[{"type":"text","text":"None — self-contained static content; no other specs or entities are involved."}]},{"id":"tpl-constraints-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Constraints"}]},{"id":"0da8fb6b","type":"paragraph","content":[{"type":"text","text":"Readable by unauthenticated visitors. Considered, none apply: performance, volume, availability, audit, privacy, locale, cost."}]},{"id":"tpl-acceptance-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Acceptance criteria"}]},{"id":"30bdbe9d","type":"bulletListItem","content":[{"type":"text","text":"A1 (verifies R1): WHEN "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":" is opened, the page displays the \"About\" heading and its body paragraphs."}]},{"id":"3e822a03","type":"bulletListItem","content":[{"type":"text","text":"A2 (verifies R2): WHEN the landing page is loaded, a link to "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":" is present in the main navigation."}]},{"id":"tpl-migration-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Migration & compatibility"}]},{"id":"06cda18b","type":"paragraph","content":[{"type":"text","text":"None — new page, nothing to migrate."}]},{"id":"tpl-artifacts-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Artifacts"}]},{"id":"aad3898d","type":"bulletListItem","content":[{"type":"text","text":"The "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":" page route and its static content."}]},{"id":"6d261a3b","type":"bulletListItem","content":[{"type":"text","text":"A navigation link to "},{"type":"text","text":"/about","styles":{"code":true}},{"type":"text","text":" on the landing page."}]},{"id":"tpl-openq-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Open Questions"}]},{"id":"d7ee9767","type":"paragraph","content":[{"type":"text","text":"None."}]}],"comments":[]}