{"content":[{"id":"tpl-intent-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Intent","styles":{"bold":true}}],"children":[]},{"id":"f7bf3051-9f5c-407e-ad3b-eeb74bbe85dc","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Provide a secure, user-friendly entry point for users to authenticate with the system. This spec defines the requirements for a standard login page that validates credentials against the existing identity provider and establishes a user session.","styles":{}}],"children":[]},{"id":"f09f8010-632c-4fe4-90eb-7855ba285e17","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scope","styles":{"bold":true}}],"children":[]},{"id":"3bbf8a85-2211-48ca-8f3e-800195dbce72","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"In-Scope:","styles":{"bold":true}}],"children":[]},{"id":"a4924da6-1c56-40fd-af30-f4ee2a6aa76b","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Username and password input fields.","styles":{}}],"children":[]},{"id":"d7da020a-e87c-4f99-afc8-60ea8d15d377","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Credential validation against ","styles":{}},{"type":"text","text":"system.iam.User","styles":{"code":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"95256cc8-85a5-4082-b176-fe9f64294049","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Error handling for invalid credentials or locked accounts.","styles":{}}],"children":[]},{"id":"ac798dd8-2b32-40ea-926a-25ccbd65f40c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Redirection to the default landing page upon successful login.","styles":{}}],"children":[]},{"id":"45cd41ca-b456-4499-9af1-ff664f1056a9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Out-of-Scope:","styles":{"bold":true}}],"children":[]},{"id":"e0b578b6-fdf5-46fb-841c-3a0521558119","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User registration/sign-up (handled by an external identity provider).","styles":{}}],"children":[]},{"id":"d484dba4-eba8-4527-bac7-240609419715","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"\"Forgot Password\" flow (handled by the identity provider).","styles":{}}],"children":[]},{"id":"8cace7a3-cb0d-4cfc-b8ab-d3b2ee6bbbf9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Multi-factor authentication (MFA) setup.","styles":{}}],"children":[]},{"id":"a7b01966-89b9-49d0-bdd2-3bc86c4920c3","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Social login (OAuth/OpenID Connect) configuration.","styles":{}}],"children":[]},{"id":"a70588d4-a937-41c9-bf44-26da1d50b19e","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scenarios","styles":{"bold":true}}],"children":[]},{"id":"bba659bd-a0dc-4d4e-825b-798a4f4bec64","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"S1: Successful Login","styles":{"bold":true}}],"children":[]},{"id":"51d33340-1c02-47af-a064-a89a02405b63","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User navigates to the login page.","styles":{}}],"children":[]},{"id":"0741b4e8-a0ec-4903-820a-68a10884c19c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User enters a valid username and password.","styles":{}}],"children":[]},{"id":"195d1d75-a9d9-49b2-a715-941f90cee742","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User clicks the \"Login\" button.","styles":{}}],"children":[]},{"id":"b0e6a82e-37c1-4f4d-9d74-67bdd1f65979","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"System validates credentials and starts a session.","styles":{}}],"children":[]},{"id":"9ef95cb7-c10b-4525-91b2-1b5b2cff8d34","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"System redirects the user to the dashboard.","styles":{}}],"children":[]},{"id":"b1bfbb0c-c6f1-445d-9893-364e2fdc1ba0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"S2: Invalid Credentials","styles":{"bold":true}}],"children":[]},{"id":"a089dfb9-2ae9-48d6-8ee9-9b7055046d45","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User enters an incorrect username or password.","styles":{}}],"children":[]},{"id":"de88f97f-b9fe-4c87-a553-230d30144551","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User clicks the \"Login\" button.","styles":{}}],"children":[]},{"id":"f5dbfeb7-d18b-4a30-9395-b0ea0940101d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"System displays a generic error message: \"Invalid username or password.\"","styles":{}}],"children":[]},{"id":"e36ea846-352d-4cb6-bf4f-5c5deec4a1e2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User remains on the login page with fields preserved (except password).","styles":{}}],"children":[]},{"id":"9cd937cf-f77d-41ea-96d5-bddaa4552085","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"S3: Account Locked","styles":{"bold":true}}],"children":[]},{"id":"57d4ec46-9e36-4857-a9a2-02460ed37a68","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"User attempts to log in to an account that has been locked due to multiple failed attempts.","styles":{}}],"children":[]},{"id":"1b377624-a1c7-402a-a351-5fa2d547d6fd","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"System displays a message: \"Account locked. Please contact support or try again later.\"","styles":{}}],"children":[]},{"id":"3c09a128-e28b-48cf-b9cd-703b7dacb943","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Requirements","styles":{"bold":true}}],"children":[]},{"id":"ddcabdf1-b4d5-4a3d-8194-4c1335e42497","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R1:","styles":{"bold":true}},{"type":"text","text":" The page SHALL provide input fields for a unique identifier (Username/Email) and a Password.","styles":{}}],"children":[]},{"id":"d0077da8-614e-4f63-ba4b-de67932acacb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R2:","styles":{"bold":true}},{"type":"text","text":" The system SHALL mask the password input by default.","styles":{}}],"children":[]},{"id":"1a2133d4-02a4-47f7-9cfe-f39b4b85c402","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R3:","styles":{"bold":true}},{"type":"text","text":" The system SHALL authenticate the user against the ","styles":{}},{"type":"text","text":"system.iam.User","styles":{"code":true}},{"type":"text","text":" entity.","styles":{}}],"children":[]},{"id":"b6d8005c-7304-4605-9892-30011f1917ef","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R4:","styles":{"bold":true}},{"type":"text","text":" Upon successful authentication, the system SHALL establish a secure session and redirect to the application's default landing page.","styles":{}}],"children":[]},{"id":"b7487b68-e8bd-4324-ad30-c078be445064","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"R5:","styles":{"bold":true}},{"type":"text","text":" The system SHALL display a generic error message for any failed authentication attempt to prevent username enumeration.","styles":{}}],"children":[]},{"id":"87498a87-e1d4-476a-931a-45d5cd8276ac","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"P1:","styles":{"bold":true}},{"type":"text","text":" Session tokens must be unique and non-predictable.","styles":{}}],"children":[]},{"id":"2b7bddaf-a69c-4bd1-96f3-75a7686ca974","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"P2:","styles":{"bold":true}},{"type":"text","text":" Password data must never be transmitted or stored in plain text (must use TLS for transport).","styles":{}}],"children":[]},{"id":"3766c858-0fa1-4600-9a9b-792cc606b475","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Data model","styles":{"bold":true}}],"children":[]},{"id":"6d7c1bfa-6c24-4926-9e35-4b6bfb363681","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Session:","styles":{"bold":true}}],"children":[]},{"id":"d9cd90ea-5751-496a-8305-ba28ba75254b","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"token","styles":{"code":true}},{"type":"text","text":" (required, unique): The secure identifier for the active session.","styles":{}}],"children":[]},{"id":"968f35bf-f127-48f4-be96-f91b292a9423","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"userId","styles":{"code":true}},{"type":"text","text":" (required): Reference to the ","styles":{}},{"type":"text","text":"system.iam.User","styles":{"code":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"5f5d0e2d-3dcf-4ecb-aabe-ba48f4aa662f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"expiry","styles":{"code":true}},{"type":"text","text":" (required): The timestamp when the session becomes invalid.","styles":{}}],"children":[]},{"id":"b4d591af-00ac-45dc-8ce3-6a1c77ab86c3","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"User interface","styles":{"bold":true}}],"children":[]},{"id":"210fafd2-0bb5-4dce-b565-77102b68e19e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The login screen should be clean and centered.","styles":{}}],"children":[]},{"id":"329022ae-334b-4073-8da2-057dc0993d6d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Fields:","styles":{"bold":true}},{"type":"text","text":" A vertical stack containing a logo, \"Username\" text field, \"Password\" text field, and a primary \"Login\" button.","styles":{}}],"children":[]},{"id":"1ca2c9b0-2792-4cc9-8f00-bc4b86ae30ad","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Feedback:","styles":{"bold":true}},{"type":"text","text":" Inline error messages should appear in red text above the login button.","styles":{}}],"children":[]},{"id":"97aab9ad-be4e-497b-afab-49ba958f8e35","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Feel:","styles":{"bold":true}},{"type":"text","text":" Professional, secure, and minimal.","styles":{}}],"children":[]},{"id":"7e6e7698-3b56-41b4-835a-4e4372e8bb93","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Dependencies","styles":{"bold":true}}],"children":[]},{"id":"dd37b861-8183-47ee-96fd-e3c062a1f156","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"system.iam.User:","styles":{"bold":true}},{"type":"text","text":" The existing entity used for identity shadows and local user records.","styles":{}}],"children":[]},{"id":"067b9c09-2a85-4310-9757-cecfbddb44e2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Identity Provider:","styles":{"bold":true}},{"type":"text","text":" External service responsible for the actual credential verification and password lifecycle.","styles":{}}],"children":[]},{"id":"f8a00826-7b04-4ea9-bf7b-4512c2f47c79","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Platform TLS:","styles":{"bold":true}},{"type":"text","text":" The platform must provide HTTPS for secure credential transmission.","styles":{}}],"children":[]},{"id":"2c83695c-c845-4c6e-8837-f12d655b238c","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Constraints","styles":{"bold":true}}],"children":[]},{"id":"96169fce-7407-4d49-98cb-27aed1f01dbd","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Security:","styles":{"bold":true}},{"type":"text","text":" Authentication attempts must be rate-limited to prevent brute-force attacks.","styles":{}}],"children":[]},{"id":"436884e3-fa02-49ab-a54e-a4d3bb888096","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Latency:","styles":{"bold":true}},{"type":"text","text":" Credential validation and redirection should complete within 2 seconds under normal load.","styles":{}}],"children":[]},{"id":"b7b20469-2a2f-4750-bc63-55c3ee22daec","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Compliance:","styles":{"bold":true}},{"type":"text","text":" Must adhere to corporate security standards for session management (e.g., session timeout after 30 minutes of inactivity).","styles":{}}],"children":[]},{"id":"66006ba5-bdb8-4580-84dc-d3931da9cbdd","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Acceptance criteria","styles":{"bold":true}}],"children":[]},{"id":"61ef8dfe-a608-4e0d-94a3-4f8bbb267499","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A1 (verifies R1, R2):","styles":{"bold":true}},{"type":"text","text":" WHEN the user views the login page, THEN the username and password fields are visible and the password field masks input.","styles":{}}],"children":[]},{"id":"a1c4ba6f-4303-42ec-ac71-c0fea7a0ee1a","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A2 (verifies R3, R4):","styles":{"bold":true}},{"type":"text","text":" WHEN valid credentials for an existing ","styles":{}},{"type":"text","text":"system.iam.User","styles":{"code":true}},{"type":"text","text":" are submitted, THEN the user is redirected to the dashboard.","styles":{}}],"children":[]},{"id":"0490e03b-3442-4bca-aef7-0036fb40f73c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A3 (verifies R5):","styles":{"bold":true}},{"type":"text","text":" WHEN incorrect credentials are submitted, THEN the message \"Invalid username or password\" is displayed and no redirect occurs.","styles":{}}],"children":[]},{"id":"d235f9f2-9525-4850-98e6-cb8bf0040e9e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A4 (verifies P2):","styles":{"bold":true}},{"type":"text","text":" WHEN a login request is intercepted, THEN the credentials must be encrypted via TLS.","styles":{}}],"children":[]},{"id":"82c73ff3-e50f-4396-99c2-fdc8a0ab26b2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A5 (verifies P1):","styles":{"bold":true}},{"type":"text","text":" WHEN multiple sessions are created, THEN each session SHALL have a unique, cryptographically random token that cannot be predicted from previous tokens.","styles":{}}],"children":[]},{"id":"7842feee-5114-4e65-8cb7-c31d34eb3ac9","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Migration & compatibility","styles":{"bold":true}}],"children":[]},{"id":"0c4e874d-5743-49df-a20d-edaf60cb2c4d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — this is a new implementation for the standard login entry point.","styles":{}}],"children":[]},{"id":"e3e005fb-c337-414e-bf0b-fe1142036801","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Artifacts","styles":{"bold":true}}],"children":[]},{"id":"1d538508-46af-4140-856f-d72f1d6ac5f8","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Login Screen (Web UI)","styles":{}}],"children":[]},{"id":"dc6d60a0-2af3-4e49-a8d6-f6b58864767d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Authentication Service","styles":{}}],"children":[]},{"id":"09f3935d-eaf3-4e82-bffd-fc60239eba7d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Session Management Logic","styles":{}}],"children":[]},{"id":"bd56cdd0-6033-4ffa-8443-3956731fadf1","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Open Questions","styles":{"bold":true}}],"children":[]},{"id":"2853f834-cf34-4e07-bb50-697ed8cc9afa","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None","styles":{}}],"children":[]},{"id":"f31c6861-4797-4ec4-9dab-a81960e3170c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}],"comments":[]}