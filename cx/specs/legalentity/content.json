{"content":[{"id":"tpl-intent-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Intent","styles":{}}],"children":[]},{"id":"bcadf8d0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A register of natural persons, each recorded with a name and an age. It serves any signed-in user of the deployment who needs to create, browse and edit person records.","styles":{}}],"children":[]},{"id":"tpl-scope-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scope","styles":{}}],"children":[]},{"id":"6a8532d2","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"In: a Person entity with name and age; its standard search screen and edit form.","styles":{}}],"children":[]},{"id":"c26f82df","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Out: relationships between persons, addresses, contact details, identity documents, and any linkage to legal entities or CDM Party — none requested.","styles":{}}],"children":[]},{"id":"5148a1c1","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Out: age auto-derivation from a date of birth — only an explicit age is held.","styles":{}}],"children":[]},{"id":"tpl-scenarios-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scenarios","styles":{}}],"children":[]},{"id":"54584f91","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — the entity supports plain create/edit/browse through its standard screens; no ordered journey beyond that is requested.","styles":{}}],"children":[]},{"id":"tpl-requirements-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Requirements","styles":{}}],"children":[]},{"id":"cb343739","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — every rule is carried by the bean table: name is required, age is a whole number between 0 and 150. The platform enforces and tests these.","styles":{}}],"children":[]},{"id":"tpl-datamodel-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Data model","styles":{}}],"children":[]},{"id":"0130b519","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"bean: Person","styles":{}}],"children":[]},{"id":"a7bdf859","type":"table","props":{"textColor":"default"},"content":{"type":"tableContent","rows":[{"cells":[{"type":"tableCell","content":[{"type":"text","text":"field","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"kind","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"required","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"notes","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}}]},{"cells":[{"type":"tableCell","content":[{"type":"text","text":"name","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"text","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"yes","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"f","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}}]},{"cells":[{"type":"tableCell","content":[{"type":"text","text":"age","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"number","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"no","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}},{"type":"tableCell","content":[{"type":"text","text":"min(0); max(150)","styles":{}}],"props":{"colspan":1,"rowspan":1,"backgroundColor":"default","textColor":"default","textAlignment":"left"}}]}],"columnWidths":[null,null,null,null],"headerRows":1},"children":[]},{"id":"979940c1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"No relationships. Age is held as stated by the author, not derived from a date of birth; it may be left empty when unknown.","styles":{}}],"children":[]},{"id":"c1590848","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Artifacts: ","styles":{}},{"type":"link","href":"#spec-attachment/entity_descriptors/party.Person.json","content":[{"type":"text","text":"Entity descriptor","styles":{}}]},{"type":"text","text":" · ","styles":{}},{"type":"link","href":"#spec-attachment/ui/party.Person.js","content":[{"type":"text","text":"Default form","styles":{}}]}],"children":[]},{"id":"tpl-ui-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"User interface","styles":{}}],"children":[]},{"id":"94566cf9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The bean's search screen and edit form — a simple register: list of persons with name and age columns, one row edited in the standard detail form.","styles":{}}],"children":[]},{"id":"tpl-dependencies-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Dependencies","styles":{}}],"children":[]},{"id":"25a32e98","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — no other spec, existing entity or external system is relied on.","styles":{}}],"children":[]},{"id":"tpl-constraints-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Constraints","styles":{}}],"children":[]},{"id":"cf028e0b","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Considered, none apply: authorization (platform default — any signed-in user), performance, volume, availability, audit, privacy, locale, cost. Note: name and age are personal data; the platform's standard audit trail covers edits.","styles":{}}],"children":[]},{"id":"tpl-acceptance-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Acceptance criteria","styles":{}}],"children":[]},{"id":"139e65fb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — the platform's generated tests cover the table rules (name required; age within 0–150).","styles":{}}],"children":[]},{"id":"tpl-migration-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Migration & compatibility","styles":{}}],"children":[]},{"id":"36630f25","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — new entity, nothing to migrate; no existing rows, users or callers are affected.","styles":{}}],"children":[]},{"id":"tpl-artifacts-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Artifacts","styles":{}}],"children":[]},{"id":"2d3da155","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A Person entity with a person search screen and edit form.","styles":{}}],"children":[]},{"id":"2c690386","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Derived from the Data model","styles":{}}],"children":[]},{"id":"890493d9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Implied by the bean blocks in the Data model and regenerated by the platform - do not edit this block; author above it what the catalog cannot derive.","styles":{}}],"children":[]},{"id":"0853c975","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Person - persistence.entity (persistence): The entity class with its builder, its descriptor + jsontype entry, its migration and table, and its tests; the descriptor is authored at spec time as the bean's entity-descriptor attachment (entity_descriptors/{qualified-descriptor-name}.json).","styles":{}}],"children":[]},{"id":"5d11a16f","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Person - observer.sheet (observer): The observer sheet: the entity's only remote surface, reads and writes.","styles":{}}],"children":[]},{"id":"5cf503b8","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Person - ui.defaultForm (ui): The default form of one row, rendered wherever the row is viewed or edited: its layout JS, authored at spec time as the spec's ui/{qualified-descriptor-name}.js attachment and shipped beside the entity class.","styles":{}}],"children":[]},{"id":"882c1aaf","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Person.age - validation.rule (persistence): min(0) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"c4309bf8","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Person.age - validation.rule (persistence): max(150) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"tpl-openq-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Open Questions","styles":{}}],"children":[]},{"id":"fff25e98","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — the request settles the fields. Whether Person should link to CDM's Party was settled from the live catalog: the deployment serves no CDM party entities, so Person is a standalone register.","styles":{}}],"children":[]},{"id":"e46f8a46-fdda-494b-8e1e-6f482518c4b9","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}],"comments":[]}