{"content":[{"id":"tpl-intent-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Intent"}]},{"id":"00b38278","type":"paragraph","content":[{"type":"text","text":"A throwaway test spec to exercise the spec workflow. It asks for one trivial behaviour: a signed-in user can see a welcome message."}]},{"id":"tpl-scope-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scope"}]},{"id":"f1c45414","type":"bulletListItem","content":[{"type":"text","text":"IN: a welcome message shown to a signed-in user."}]},{"id":"175f2d5a","type":"bulletListItem","content":[{"type":"text","text":"OUT: any stored data, configuration, or personalisation."}]},{"id":"tpl-scenarios-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scenarios"}]},{"id":"c3645b73","type":"paragraph","content":[{"type":"text","text":"None — a single display behaviour, no ordered journey."}]},{"id":"tpl-requirements-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Requirements"}]},{"id":"9d603e2d","type":"bulletListItem","content":[{"type":"text","text":"R1: WHEN a user signs in, the system SHALL display the message \"Welcome\"."}]},{"id":"tpl-datamodel-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Data model"}]},{"id":"73bf82c1","type":"paragraph","content":[{"type":"text","text":"None — nothing is stored."}]},{"id":"tpl-ui-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"User interface"}]},{"id":"04e58b7b","type":"paragraph","content":[{"type":"text","text":"None — no root bean, so no screen of its own; the message appears on the page the user lands on after sign-in."}]},{"id":"tpl-dependencies-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Dependencies"}]},{"id":"db2bdcfa","type":"paragraph","content":[{"type":"text","text":"None — no other specs or entities."}]},{"id":"tpl-constraints-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Constraints"}]},{"id":"b80d9c78","type":"paragraph","content":[{"type":"text","text":"Considered, none apply: authorization, performance, volume, availability, audit, privacy, locale, cost."}]},{"id":"tpl-acceptance-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Acceptance criteria"}]},{"id":"d15d884e","type":"bulletListItem","content":[{"type":"text","text":"A1 (verifies R1): WHEN a user signs in, the page they land on SHALL contain the text \"Welcome\"."}]},{"id":"tpl-migration-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Migration & compatibility"}]},{"id":"f7ec432e","type":"paragraph","content":[{"type":"text","text":"None — new behaviour, nothing existing to migrate."}]},{"id":"tpl-artifacts-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Artifacts"}]},{"id":"9887df2c","type":"paragraph","content":[{"type":"text","text":"None."}]},{"id":"tpl-openq-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Open Questions"}]},{"id":"2f189e53","type":"paragraph","content":[{"type":"text","text":"None."}]}],"comments":[]}