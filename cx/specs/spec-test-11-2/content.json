{"content":[{"id":"tpl-intent-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Intent"}]},{"id":"586ea7b8","type":"paragraph","content":[{"type":"text","text":"A deliberately trivial spec used to test the spec approval flow. It defines one tiny greeting behaviour so that every section can be authored and checked end to end."}]},{"id":"tpl-scope-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scope"}]},{"id":"6b9e918c","type":"bulletListItem","content":[{"type":"text","text":"IN: a single greeting message returned on request."}]},{"id":"fba97912","type":"bulletListItem","content":[{"type":"text","text":"OUT: any data storage, screens, personalisation or localisation."}]},{"id":"tpl-scenarios-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scenarios"}]},{"id":"7883b1ca","type":"paragraph","content":[{"type":"text","text":"None — a single request/response behaviour, no ordered journey."}]},{"id":"tpl-requirements-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Requirements"}]},{"id":"54767670","type":"bulletListItem","content":[{"type":"text","text":"R1: WHEN a greeting is requested, the system SHALL respond with the exact text \"Hello, world\"."}]},{"id":"tpl-datamodel-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Data model"}]},{"id":"536d6c6f","type":"paragraph","content":[{"type":"text","text":"None — nothing is stored."}]},{"id":"tpl-ui-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"User interface"}]},{"id":"3095adc9","type":"paragraph","content":[{"type":"text","text":"None — no user-facing surface."}]},{"id":"tpl-dependencies-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Dependencies"}]},{"id":"5f39cc33","type":"paragraph","content":[{"type":"text","text":"None — relies on no other spec, entity or external system."}]},{"id":"tpl-constraints-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Constraints"}]},{"id":"2c8461fb","type":"paragraph","content":[{"type":"text","text":"Considered, none apply: authorization beyond the platform default, performance, volume, availability, audit, privacy, locale, cost."}]},{"id":"tpl-acceptance-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Acceptance criteria"}]},{"id":"67e37d9b","type":"bulletListItem","content":[{"type":"text","text":"A1 (verifies R1): WHEN a greeting is requested, the system SHALL respond with exactly \"Hello, world\"."}]},{"id":"tpl-migration-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Migration & compatibility"}]},{"id":"7ba43707","type":"paragraph","content":[{"type":"text","text":"None — new behaviour, nothing existing to migrate."}]},{"id":"tpl-artifacts-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Artifacts"}]},{"id":"bf49a711","type":"paragraph","content":[{"type":"text","text":"None."}]},{"id":"tpl-openq-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Open Questions"}]},{"id":"31cb706e","type":"paragraph","content":[{"type":"text","text":"None."}]}],"comments":[]}