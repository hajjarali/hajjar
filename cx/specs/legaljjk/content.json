{"content":[{"id":"tpl-intent-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Intent","styles":{}}],"children":[]},{"id":"7cbacab0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A register of persons — the people the business deals with — holding each person's name and age. It gives any signed-in user a place to create, browse, edit and retire person records, and serves as the reference list other features can point at.","styles":{}}],"children":[]},{"id":"tpl-scope-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scope","styles":{}}],"children":[]},{"id":"51397694","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"IN:","styles":{}}],"children":[]},{"id":"25681f03","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A Person entity with name and age, its standard screens (search/list, detail/edit form), and its lifecycle (draft | active | retired).","styles":{}}],"children":[]},{"id":"a1c82cf6","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"OUT (non-goals):","styles":{}}],"children":[]},{"id":"f0ac2b30","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Identity, authentication or login — users of the system are served by the identity plane, not by this register.","styles":{}}],"children":[]},{"id":"b9d86aa6","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Legal entities, organizations or company registers.","styles":{}}],"children":[]},{"id":"9446806d","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Identifiers beyond the name (national ID, passport, tax number) and contact details (address, email, phone).","styles":{}}],"children":[]},{"id":"665fa8a5","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Any relationship from a person to other business objects — none is requested yet.","styles":{}}],"children":[]},{"id":"tpl-scenarios-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Scenarios","styles":{}}],"children":[]},{"id":"2d74c858","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — the bean's standard screens cover create, browse and edit; no ordered journey beyond them is requested.","styles":{}}],"children":[]},{"id":"tpl-requirements-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Requirements","styles":{}}],"children":[]},{"id":"e28bf6d7","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — every rule is carried by the bean table.","styles":{}}],"children":[]},{"id":"tpl-datamodel-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Data model","styles":{}}],"children":[]},{"id":"5dfcf945","type":"heading","props":{"backgroundColor":"default","textCol