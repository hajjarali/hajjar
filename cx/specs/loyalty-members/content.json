ype":"text","text":"Member - ui.defaultForm (ui): The default form of one row, rendered wherever the row is viewed or edited: its layout JS, authored at spec time as the spec's ui/{qualified-descriptor-name}.js attachment and shipped beside the entity class.","styles":{}}],"children":[]},{"id":"95ff1cd9","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Member.memberNumber - validation.rule (persistence): unique - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"7222fdd5","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Member.memberNumber - validation.rule (persistence): immutable - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"923006d7","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Member.status - validation.rule (persistence): default(pending) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"79c3609b","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Member.pointsBalance - validation.rule (persistence): default(0) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"abd5b3ac","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Member.marketingConsent - validation.rule (persistence): default(false) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"4883c1ab","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Address - embeddedBean (bean): A bean another bean embeds: its class with its builder, its descriptor + jsontype entry and its tests - a plain bean with NO persistence descriptor, so no migration, no table and no sheet; it lives inside the row of the bean that embeds it, and its descriptor is authored at spec time as its entity-descriptor attachment (entity_descriptors/{qualified-descriptor-name}.json).","styles":{}}],"children":[]},{"id":"c4d268e1","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Address - ui.defaultForm (ui): The default form of one row, rendered wherever the row is viewed or edited: its layout JS, authored at spec time as the spec's ui/{qualified-descriptor-name}.js attachment and shipped beside the entity class.","styles":{}}],"children":[]},{"id":"b2d7817a","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"LoyaltyCard - embeddedBean (bean): A bean another bean embeds: its class with its builder, its descriptor + jsontype entry and its tests - a plain bean with NO persistence descriptor, so no migration, no table and no sheet; it lives inside the row of the bean that embeds it, and its descriptor is authored at spec time as its entity-descriptor attachment (entity_descriptors/{qualified-descriptor-name}.json).","styles":{}}],"children":[]},{"id":"ae5bc747","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"LoyaltyCard - ui.defaultForm (ui): The default form of one row, rendered wherever the row is viewed or edited: its layout JS, authored at spec time as the spec's ui/{qualified-descriptor-name}.js attachment and shipped beside the entity class.","styles":{}}],"children":[]},{"id":"59834833","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"LoyaltyCard.lastFour - validation.rule (persistence): format(4 digits) - enforced on save and covered by a generated test","styles":{}}],"children":[]},{"id":"tpl-openq-h","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Open Questions","styles":{}}],"children":[]},{"id":"52fcb5eb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"None — the request settled the data model and its rules in full.","styles":{}}],"children":[]},{"id":"d4acea54-bda2-471d-bd0b-2d6d259c4424","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}],"comments":[]}