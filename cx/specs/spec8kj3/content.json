{"content":[{"id":"tpl-intent-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Intent"}]},{"id":"b5be68b5","type":"paragraph","content":[{"type":"text","text":"A trivial placeholder spec: the system greets a user by name. It exists to exercise the spec workflow, not to deliver business value."}]},{"id":"tpl-scope-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scope"}]},{"id":"2a067af6","type":"bulletListItem","content":[{"type":"text","text":"IN: returning the greeting \"Hello, NAME!\" for a given name, where NAME is the supplied name."}]},{"id":"a045c8b6","type":"bulletListItem","content":[{"type":"text","text":"OUT: storage, screens, localisation."}]},{"id":"tpl-scenarios-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Scenarios"}]},{"id":"3007a5a0","type":"paragraph","content":[{"type":"text","text":"None — a single request/response, no ordering of steps matters."}]},{"id":"tpl-requirements-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Requirements"}]},{"id":"0265f542","type":"bulletListItem","content":[{"type":"text","text":"R1: WHEN a name is supplied, the system SHALL return the text \"Hello, NAME!\", where NAME is the supplied name."}]},{"id":"7bb18223","type":"bulletListItem","content":[{"type":"text","text":"R2: IF no name is supplied, THEN the system SHALL return \"Hello, world!\"."}]},{"id":"tpl-datamodel-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Data model"}]},{"id":"cb0d3123","type":"paragraph","content":[{"type":"text","text":"None — nothing is stored."}]},{"id":"tpl-ui-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"User interface"}]},{"id":"2f1d89a2","type":"paragraph","content":[{"type":"text","text":"None — no user-facing surface; the beans are edited through their default forms inside the screens that reach them."}]},{"id":"tpl-dependencies-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Dependencies"}]},{"id":"103c5311","type":"paragraph","content":[{"type":"text","text":"None."}]},{"id":"tpl-constraints-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Constraints"}]},{"id":"31ebf498","type":"paragraph","content":[{"type":"text","text":"Considered, none apply: authorization, performance, volume, availability, audit, privacy, locale, cost."}]},{"id":"tpl-acceptance-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Acceptance criteria"}]},{"id":"e16ddea8","type":"bulletListItem","content":[{"type":"text","text":"A1 (verifies R1): WHEN the name \"Ada\" is supplied, the system SHALL return exactly \"Hello, Ada!\"."}]},{"id":"3884d39f","type":"bulletListItem","content":[{"type":"text","text":"A2 (verifies R2): WHEN no name is supplied, the system SHALL return exactly \"Hello, world!\"."}]},{"id":"tpl-migration-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Migration & compatibility"}]},{"id":"8c69a98a","type":"paragraph","content":[{"type":"text","text":"None — new capability, nothing to migrate."}]},{"id":"tpl-artifacts-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Artifacts"}]},{"id":"0671a994","type":"paragraph","content":[{"type":"text","text":"None."}]},{"id":"tpl-openq-h","type":"heading","props":{"level":2},"content":[{"type":"text","text":"Open Questions"}]},{"id":"f4c5f3ee","type":"paragraph","content":[{"type":"text","text":"None."}]}],"comments":[]}